import { OllamaEmbeddings } from "@langchain/community/embeddings/ollama";
import { Ollama } from "@langchain/community/llms/ollama";
import { RecursiveCharacterTextSplitter } from "langchain/text_splitter";
import { MemoryVectorStore } from "langchain/vectorstores/memory";
import { PromptTemplate } from "@langchain/core/prompts";
import { RunnablePassthrough } from "@langchain/core/runnables";
import { StringOutputParser } from "@langchain/core/output_parsers";
import { Document } from "@langchain/core/documents";
import fs from "fs";
import path from "path";
import { fileURLToPath } from "url";

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

/*
--------------------------------
CONFIGURATION
--------------------------------
*/

const config = {
  model: "llama3",
  embeddingModel: "nomic-embed-text",
  temperature: 0.7,
  topK: 2,
  chunkSize: 1000,
  chunkOverlap: 200,
  ollamaBaseUrl: "http://localhost:11434"
};

/*
--------------------------------
INITIALIZE MODELS
--------------------------------
*/

async function initializeComponents() {
  console.log("Initializing LangChain models...");

  try {
    const embeddings = new OllamaEmbeddings({
      model: config.embeddingModel,
      baseUrl: config.ollamaBaseUrl
    });

    const llm = new Ollama({
      model: config.model,
      baseUrl: config.ollamaBaseUrl,
      temperature: config.temperature
    });

    console.log("✓ Models initialized successfully");
    return { embeddings, llm };
  } catch (error) {
    console.error("Failed to initialize models:", error.message);
    throw error;
  }
}

/*
--------------------------------
LOAD DOCUMENTS
--------------------------------
*/

async function loadDocuments() {
  const docsPath = path.join(__dirname, "embeddings", "docs");

  if (!fs.existsSync(docsPath)) {
    throw new Error(`Docs folder not found at: ${docsPath}`);
  }

  const files = fs.readdirSync(docsPath);
  const documents = [];

  for (const file of files) {
    if (!file.endsWith(".txt")) continue;

    const filePath = path.join(docsPath, file);
    const content = fs.readFileSync(filePath, "utf-8");

    documents.push(
      new Document({
        pageContent: content,
        metadata: { source: file }
      })
    );

    console.log(`✓ Loaded: ${file}`);
  }

  if (documents.length === 0) {
    throw new Error("No .txt files found in embeddings/docs directory");
  }

  console.log(`Total documents loaded: ${documents.length}\n`);
  return documents;
}

/*
--------------------------------
SPLIT DOCUMENTS INTO CHUNKS
--------------------------------
*/

async function splitDocuments(documents) {
  console.log("Splitting documents into chunks...");

  const splitter = new RecursiveCharacterTextSplitter({
    chunkSize: config.chunkSize,
    chunkOverlap: config.chunkOverlap
  });

  const chunks = await splitter.splitDocuments(documents);

  console.log(`✓ Created ${chunks.length} chunks\n`);
  return chunks;
}

/*
--------------------------------
CREATE VECTOR STORE
--------------------------------
*/

async function createVectorStore(chunks, embeddings) {
  console.log("Creating vector store from chunks...");

  try {
    const vectorStore = await MemoryVectorStore.fromDocuments(
      chunks,
      embeddings
    );

    console.log("✓ Vector store created successfully\n");
    return vectorStore;
  } catch (error) {
    console.error("Failed to create vector store:", error.message);
    throw error;
  }
}

/*
--------------------------------
CREATE RAG CHAIN
--------------------------------
*/

async function createRAGChain(vectorStore, llm) {
  console.log("Creating RAG chain...");

  // Create the prompt template
  const promptTemplate = PromptTemplate.fromTemplate(`
You are a helpful assistant. Answer the question based on the provided context.

If you cannot find the answer in the context, say: "I don't know based on the provided documents."

Context:
{context}

Question: {question}

Answer:`);

  // Create the retriever
  const retriever = vectorStore.asRetriever({
    k: config.topK
  });

  // Create the RAG chain using LCEL (LangChain Expression Language)
  const chain = RunnableParallel.new({
    context: retriever.pipe(
      (results) =>
        results
          .map((doc) => doc.pageContent)
          .join("\n---\n")
    ),
    question: new RunnablePassthrough()
  })
    .pipe(promptTemplate)
    .pipe(llm)
    .pipe(new StringOutputParser());

  console.log("✓ RAG chain created successfully\n");
  return { chain, retriever };
}

/*
--------------------------------
ASK QUESTION
--------------------------------
*/

async function askQuestion(chain, retriever, question) {
  console.log(`Question: ${question}\n`);

  try {
    // Get the answer
    const answer = await chain.invoke(question);

    console.log("Answer:");
    console.log(answer);

    // Get source documents
    const relevantDocs = await retriever.invoke(question);
    
    if (relevantDocs.length > 0) {
      console.log("\n--- Source Documents ---");
      relevantDocs.forEach((doc, index) => {
        console.log(`\n[Source ${index + 1}: ${doc.metadata.source}]`);
        console.log(doc.pageContent.substring(0, 300) + "...");
      });
    }

    return answer;
  } catch (error) {
    console.error("Error asking question:", error.message);
    throw error;
  }
}

/*
--------------------------------
MAIN EXECUTION
--------------------------------
*/

async function main() {
  try {
    console.log("\n" + "=".repeat(50));
    console.log("RAG SYSTEM WITH LANGCHAIN");
    console.log("=".repeat(50) + "\n");

    // Step 1: Initialize components
    console.log("Step 1: Initializing Components");
    console.log("-".repeat(50));
    const { embeddings, llm } = await initializeComponents();

    // Step 2: Load documents
    console.log("Step 2: Loading Documents");
    console.log("-".repeat(50));
    const documents = await loadDocuments();

    // Step 3: Split documents
    console.log("Step 3: Splitting Documents");
    console.log("-".repeat(50));
    const chunks = await splitDocuments(documents);

    // Step 4: Create vector store
    console.log("Step 4: Creating Vector Store");
    console.log("-".repeat(50));
    const vectorStore = await createVectorStore(chunks, embeddings);

    // Step 5: Create RAG chain
    console.log("Step 5: Setting Up RAG Chain");
    console.log("-".repeat(50));
    const { chain, retriever } = await createRAGChain(vectorStore, llm);

    // Step 6: Ask questions
    console.log("Step 6: Asking Questions");
    console.log("-".repeat(50) + "\n");

    await askQuestion(chain, retriever, "What is the surrender policy?");

    // Uncomment to ask more questions
    // console.log("\n" + "=".repeat(50) + "\n");
    // await askQuestion(chain, retriever, "What are annuities?");

    console.log("\n" + "=".repeat(50));
    console.log("RAG SYSTEM COMPLETE");
    console.log("=".repeat(50) + "\n");

    process.exit(0);
  } catch (error) {
    console.error("\n✗ ERROR:", error.message);
    console.error(error.stack);
    process.exit(1);
  }
}

// Run the application
main();
