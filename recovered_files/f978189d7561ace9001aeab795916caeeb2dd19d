import OpenAI from "openai"
import axios from "axios"

const client = new OpenAI({
  apiKey: process.env.OPENAI_API_KEY
})

/*
--------------------------------
TOOLS
--------------------------------
*/

async function getWeather(city) {

  const geo = await axios.get(
    `https://geocoding-api.open-meteo.com/v1/search?name=${city}`
  )

  const { latitude, longitude } = geo.data.results[0]

  const weather = await axios.get(
    `https://api.open-meteo.com/v1/forecast?latitude=${latitude}&longitude=${longitude}&current_weather=true`
  )

  return weather.data.current_weather
}

async function calculate(expression) {
  return eval(expression)
}

/*
--------------------------------
TOOL REGISTRY
--------------------------------
*/

const tools = {
  getWeather,
  calculate
}

/*
--------------------------------
AGENT PROMPT
--------------------------------
*/

const systemPrompt = `
You are an autonomous AI agent.

Your job is to achieve the user's goal step by step.

You can use tools.

When you want to use a tool return JSON:

{
 "action": "tool_name",
 "input": { ... }
}

When the task is complete return:

{
 "action": "finish",
 "answer": "final answer"
}
`

/*
--------------------------------
AGENT LOOP
--------------------------------
*/

async function runAgent(goal) {

  let history = []

  for (let step = 0; step < 10; step++) {

    const response = await client.chat.completions.create({
      model: "gpt-4.1",
      messages: [
        { role: "system", content: systemPrompt },
        { role: "user", content: `Goal: ${goal}` },
        ...history
      ]
    })

    const message = response.choices[0].message.content

    console.log("\nLLM Response:")
    console.log(message)

    let action

    try {
      action = JSON.parse(message)
    } catch {
      console.log("Invalid JSON")
      break
    }

    if (action.action === "finish") {
      console.log("\nFINAL ANSWER:\n")
      console.log(action.answer)
      break
    }

    const tool = tools[action.action]

    if (!tool) {
      console.log("Unknown tool")
      break
    }

    const result = await tool(...Object.values(action.input))

    console.log("\nTool Result:", result)

    history.push({
      role: "assistant",
      content: message
    })

    history.push({
      role: "user",
      content: `Observation: ${JSON.stringify(result)}`
    })
  }
}

/*
--------------------------------
RUN
--------------------------------
*/

runAgent("Tell me the weather in Pune and convert temperature to Fahrenheit")
