import OpenAI from "openai";
import { ChromaClient } from "chromadb";
import fs from "fs";

const openai = new OpenAI({
  apiKey: process.env.OPENAI_API_KEY
});

const chroma = new ChromaClient();

async function setupVectorDB() {

  const collection = await chroma.createCollection({
    name: "insurance_docs"
  });

  const files = fs.readdirSync("./docs");

  for (const file of files) {

    const text = fs.readFileSync(`./docs/${file}`, "utf-8");

    const embedding = await openai.embeddings.create({
      model: "text-embedding-3-small",
      input: text
    });

    await collection.add({
      ids: [file],
      embeddings: [embedding.data[0].embedding],
      documents: [text]
    });

    console.log("Indexed:", file);
  }

  return collection;
}

async function askQuestion(collection, question) {

  const embedding = await openai.embeddings.create({
    model: "text-embedding-3-small",
    input: question
  });

  const results = await collection.query({
    queryEmbeddings: [embedding.data[0].embedding],
    nResults: 2
  });

  const context = results.documents[0].join("\n");

  const response = await openai.chat.completions.create({
    model: "gpt-4.1",
    messages: [
      {
        role: "system",
        content: "Answer using the provided context"
      },
      {
        role: "user",
        content: `
Context:
${context}

Question:
${question}
`
      }
    ]
  });

  console.log("\nAnswer:\n");
  console.log(response.choices[0].message.content);
}

async function main() {

  const collection = await setupVectorDB();

  await askQuestion(
    collection,
    "What is the surrender policy for life insurance?"
  );
}

main();
