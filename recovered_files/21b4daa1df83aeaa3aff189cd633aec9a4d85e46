import { GoogleGenerativeAI } from "@google/generative-ai";
import axios from "axios";

const genAI = new GoogleGenerativeAI('AIzaSyDVEC7FFWQw22HPoldRL_NHZD-bhlhW7KY');

// ----------------------
// TOOL IMPLEMENTATION
// ----------------------
async function getWeather(city) {

  const geo = await axios.get(
    `https://geocoding-api.open-meteo.com/v1/search?name=${city}`
  );

  if (!geo.data.results || geo.data.results.length === 0) {
    return `City ${city} not found`;
  }

  const { latitude, longitude } = geo.data.results[0];

  const weather = await axios.get(
    `https://api.open-meteo.com/v1/forecast?latitude=${latitude}&longitude=${longitude}&current_weather=true`
  );

  return weather.data.current_weather;
}

// ----------------------
// MODEL + TOOL DEFINITION
// ----------------------
const model = genAI.getGenerativeModel({
  model: "gemini-2.5-flash",
  tools: [
    {
      functionDeclarations: [
        {
          name: "getWeather",
          description: "Get current weather for a city",
          parameters: {
            type: "object",
            properties: {
              city: {
                type: "string",
                description: "City name"
              }
            },
            required: ["city"]
          }
        }
      ]
    }
  ]
});

// ----------------------
// MAIN AGENT LOOP
// ----------------------
async function runAgent() {

  const contents = [
    {
      role: "user",
      parts: [{ text: "What is the weather in Raipur today?" }]
    }
  ];

  const result = await model.generateContent({
    contents
  });

  const response = result.response;
  const part = response.candidates[0].content.parts[0];

  // If LLM wants to call tool
  if (part.functionCall) {

    const { name, args } = part.functionCall;

    console.log("LLM requested tool:", name);
    console.log("Arguments:", args);

    const toolResult = await getWeather(args.city);

    contents.push({
      role: "model",
      parts: [
        {
          functionCall: {
            name,
            args
          }
        }
      ]
    });

    contents.push({
      role: "user",
      parts: [
        {
          functionResponse: {
            name,
            response: toolResult
          }
        }
      ]
    });

    const final = await model.generateContent({
      contents
    });

    console.log("\nFinal Answer:\n");

    console.log(
      final.response.candidates[0].content.parts[0].text
    );

  } else {
    console.log(part.text);
  }
}

runAgent();