import { OllamaEmbeddings } from "@langchain/community/embeddings/ollama"
import { Ollama } from "@langchain/community/llms/ollama"
import { RecursiveCharacterTextSplitter } from "langchain/text_splitter"
import { MemoryVectorStore } from "langchain/vectorstores/memory"
import { PromptTemplate } from "@langchain/core/prompts"
import { RetrievalQAChain } from "langchain/chains"
import { Document } from "@langchain/core/documents"

import fs from "fs"
import path from "path"
import { fileURLToPath } from "url"

const __filename = fileURLToPath(import.meta.url)
const __dirname = path.dirname(__filename)

/*
--------------------------------
CONFIG
--------------------------------
*/

const config = {
  model: "llama3",
  embeddingModel: "nomic-embed-text",
  temperature: 0.7,
  topK: 2,
  chunkSize: 1000,
  chunkOverlap: 200,
  ollamaBaseUrl: "http://localhost:11434"
}

/*
--------------------------------
INIT MODELS
--------------------------------
*/

async function initializeComponents() {
  console.log("Initializing models...")

  const embeddings = new OllamaEmbeddings({
    model: config.embeddingModel,
    baseUrl: config.ollamaBaseUrl
  })

  const llm = new Ollama({
    model: config.model,
    baseUrl: config.ollamaBaseUrl,
    temperature: config.temperature
  })

  return { embeddings, llm }
}

/*
--------------------------------
LOAD DOCUMENTS
--------------------------------
*/

async function loadDocuments() {
  const docsPath = path.join(__dirname, "embeddings", "docs")

  if (!fs.existsSync(docsPath)) {
    throw new Error("Docs folder not found: embeddings/docs")
  }

  const files = fs.readdirSync(docsPath)

  const documents = []

  for (const file of files) {
    if (!file.endsWith(".txt")) continue

    const content = fs.readFileSync(
      path.join(docsPath, file),
      "utf-8"
    )

    documents.push(
      new Document({
        pageContent: content,
        metadata: { source: file }
      })
    )

    console.log("Loaded:", file)
  }

  return documents
}

/*
--------------------------------
SPLIT DOCUMENTS
--------------------------------
*/

async function splitDocuments(documents) {
  console.log("Splitting documents...")

  const splitter = new RecursiveCharacterTextSplitter({
    chunkSize: config.chunkSize,
    chunkOverlap: config.chunkOverlap
  })

  const chunks = await splitter.splitDocuments(documents)

  console.log("Chunks created:", chunks.length)

  return chunks
}

/*
--------------------------------
VECTOR STORE
--------------------------------
*/

async function createVectorStore(chunks, embeddings) {
  console.log("Creating vector store...")

  const vectorStore = await MemoryVectorStore.fromDocuments(
    chunks,
    embeddings
  )

  return vectorStore
}

/*
--------------------------------
QA CHAIN
--------------------------------
*/

async function createQAChain(vectorStore, llm) {

  const prompt = new PromptTemplate({
    template: `
You are a helpful assistant.

Use the following context to answer the question.

If the answer is not in the context say:
"I don't know based on the provided documents."

Context:
{context}

Question:
{question}

Answer:
`,
    inputVariables: ["context", "question"]
  })

  const chain = RetrievalQAChain.fromLLM(
    llm,
    vectorStore.asRetriever({
      k: config.topK
    }),
    {
      prompt
    }
  )

  return chain
}

/*
--------------------------------
ASK QUESTION
--------------------------------
*/

async function askQuestion(chain, question) {

  console.log("\nQuestion:", question)

  const result = await chain.invoke({
    query: question
  })

  console.log("\nAnswer:\n")
  console.log(result.result)

  return result
}

/*
--------------------------------
MAIN
--------------------------------
*/

async function main() {

  console.log("\n============================")
  console.log("RAG SYSTEM START")
  console.log("============================\n")

  const { embeddings, llm } = await initializeComponents()

  const docs = await loadDocuments()

  const chunks = await splitDocuments(docs)

  const vectorStore = await createVectorStore(
    chunks,
    embeddings
  )

  const qaChain = await createQAChain(
    vectorStore,
    llm
  )

  await askQuestion(
    qaChain,
    "What is the surrender policy?"
  )

  console.log("\n============================")
  console.log("DONE")
  console.log("============================")
}

main()