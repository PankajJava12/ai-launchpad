{
  "family": "rag-app",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::211722901347:role/rag-ecs-task-execution-role",
  "taskRoleArn": "arn:aws:iam::211722901347:role/rag-ecs-task-role",
  "containerDefinitions": [
    {
      "name": "rag-app",
      "image": "211722901347.dkr.ecr.ap-south-1.amazonaws.com/rag-app:latest",
      "portMappings": [
        {
          "containerPort": 3000,
          "hostPort": 3000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "API_PORT",
          "value": "3000"
        },
        {
          "name": "VECTOR_STORE",
          "value": "vectorDB"
        },
        {
          "name": "DB_HOST",
          "value": "rag-db-instance.cj0swiis4f5d.ap-south-1.rds.amazonaws.com"
        },
        {
          "name": "DB_PORT",
          "value": "5432"
        },
        {
          "name": "DB_USER",
          "value": "postgres"
        },
        {
          "name": "DB_PASSWORD",
          "value": "ChangeMe123!@#"
        },
        {
          "name": "DB_NAME",
          "value": "vectordb"
        },
        {
          "name": "OLLAMA_BASE_URL",
          "value": "http://10.0.10.41:11434"
        },
        {
          "name": "OLLAMA_MODEL",
          "value": "llama3"
        },
        {
          "name": "OLLAMA_EMBEDDING_MODEL",
          "value": "nomic-embed-text"
        },
        {
          "name": "OLLAMA_TEMPERATURE",
          "value": "0.7"
        },
        {
          "name": "LOG_LEVEL",
          "value": "info"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/rag-app",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:3000/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      }
    }
  ]
}
