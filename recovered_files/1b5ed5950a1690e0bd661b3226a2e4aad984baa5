        "command": ["CMD-SHELL", "curl -f http://localhost:3000/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      }
    }
  ]
}
EOF

# Replace variables in task definition
sed -i.bak "s|\${REPO_URI}|${REPO_URI}|g" task-definition.json
sed -i.bak "s|\${ECS_TASK_EXECUTION_ROLE}|${ECS_TASK_EXECUTION_ROLE}|g" task-definition.json
sed -i.bak "s|\${ECS_TASK_ROLE}|${ECS_TASK_ROLE}|g" task-definition.json
sed -i.bak "s|\${RDS_ENDPOINT}|${RDS_ENDPOINT}|g" task-definition.json
sed -i.bak "s|\${INSTANCE_PRIVATE_IP}|${INSTANCE_PRIVATE_IP}|g" task-definition.json
sed -i.bak "s|\${AWS_REGION}|${AWS_REGION}|g" task-definition.json

# Register task definition
TASK_DEF_ARN=$(aws ecs register-task-definition \
  --cli-input-json file://task-definition.json \
  --region $AWS_REGION \
  --query 'taskDefinition.taskDefinitionArn' \
  --output text)

echo "Task Definition ARN: $TASK_DEF_ARN"
```

### Step 16: Create ECS Service

```bash
# Create ECS service
SERVICE_ARN=$(aws ecs create-service \
  --cluster $CLUSTER_NAME \
